# =============================================================
# Arquivo de EXEMPLO de variáveis de ambiente
# -------------------------------------------------------------
# 1. Copie este arquivo e renomeie a cópia para ".env"
# 2. Preencha os valores de acordo com a sua máquina
# 3. NUNCA faça commit do arquivo .env (ele já está no .gitignore)
# =============================================================

# Porta em que o servidor Express vai rodar
PORT=3000

# Configurações do banco de dados MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=estoque
